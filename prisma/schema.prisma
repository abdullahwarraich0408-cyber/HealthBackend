  started_at      DateTime?
  completed_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  appointment   DoctorAppointment         @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  relationship  DoctorPatientRelationship @relation(fields: [relationship_id], references: [id], onDelete: Cascade)
  doctor        Doctor                    @relation(fields: [doctor_id], references: [id])
  patient       User                      @relation(fields: [patient_id], references: [id])
  prescriptions DoctorPrescription[]
  lab_orders    LabTestBooking[]

  @@index([doctor_id, patient_id])
  @@index([relationship_id])
  @@map("consultations")
}

