generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String?
  role         String   // "customer", "admin", "vendor", "doctor", "lab", "hospital"
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  customer     User?
  vendor       Vendor?
  doctor       Doctor?
  lab_partner  LabPartner?
  vendor_staff VendorStaff?

  @@map("accounts")
}

model User {
  id                       String    @id @default(uuid())
  account_id               String?   @unique
  firebase_uid             String?   @unique
  email                    String?   @unique
  password                 String?
  name                     String    @default("")
  role                     String    @default("customer") // customer, admin
  phone                    String?   @unique
  avatar                   String?
  date_of_birth            DateTime?
  gender                   String?
  is_verified              Boolean   @default(false)
  membership_status        String    @default("FREE") // FREE, CARE_PLUS, FAMILY_PLUS
  membership_expiry        DateTime?
  addresses                Json?
  profile_data             Json?
  notification_preferences Json?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  account           Account?       @relation(fields: [account_id], references: [id])
  sessions          UserSession[]
  family_profiles   FamilyProfile[]
  memberships       Membership[]

  orders              Order[]
  prescriptions       Prescription[]
  prescription_orders PrescriptionOrder[]
  reviews             Review[]
  return_requests     ReturnRequest[]
  doctor_appointments DoctorAppointment[]
  doctor_reviews      DoctorReview[]
  lab_test_bookings   LabTestBooking[]
  doctor_relationships DoctorPatientRelationship[]
  consultations        Consultation[]
  doctor_prescriptions DoctorPrescription[]
  medical_documents    MedicalDocument[]
  record_shares        RecordShare[]
  inventory_reservations InventoryReservation[]
  offer_redemptions      OfferRedemption[]

  community_posts          CommunityPost[]
  community_comments       CommunityComment[]
  community_post_likes     CommunityPostLike[]
  group_memberships        GroupMember[]
  challenge_participations ChallengeParticipant[]
  buddies_owned            HealthBuddy[] @relation("BuddyOwner")
  buddies_friend_of        HealthBuddy[] @relation("BuddyFriend")
  community_profile        CommunityProfile?
  groups_created           HealthGroup[] @relation("GroupCreator")
  challenges_created       HealthChallenge[] @relation("ChallengeCreator")
  family_health_vaults     FamilyHealthVault[]

  @@map("users")
}

model UserSession {
  id            String   @id @default(uuid())
  user_id       String
  device_id     String
  platform      String   // web, android, ios
  refresh_token String   @unique
  fcm_token     String?
  expires_at    DateTime
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([device_id])
  @@map("user_sessions")
}

model FamilyProfile {
  id            String    @id @default(uuid())
  user_id       String
  full_name     String
  relationship  String
  gender        String?
  date_of_birth DateTime?
  blood_group   String?
  medical_notes String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("family_profiles")
}

model Membership {
  id         String    @id @default(uuid())
  user_id    String
  plan       String    // FREE, CARE_PLUS, FAMILY_PLUS
  status     String    @default("active") // active, expired, cancelled
  start_date DateTime  @default(now())
  end_date   DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("memberships")
}

model Vendor {
  id                         String   @id @default(uuid())
  account_id                 String?  @unique
  email                      String?  @unique
  password                   String?
  business_name              String
  license_number             String
  status                     String   @default("pending") // pending, approved, rejected
  commission_rate            Float    @default(10.0)
  trade_license_url          String?
  pharmacist_certificate_url String?
  ntn                        String?
  bank_account_title         String?
  bank_account_number        String?
  bank_name                  String?
  iban                       String?
  payout_schedule            String?  @default("weekly")
  slug                       String?
  phone                      String?
  whatsapp                   String?
  logo_url                   String?
  address                    String?
  city                       String?
  province                   String?
  postal_code                String?
  legal_business_name        String?
  owner_name                 String?
  business_type              String?
  license_expiry             DateTime?
  pickup_enabled             Boolean  @default(true)
  delivery_enabled           Boolean  @default(true)
  min_order_amount           Float    @default(0)
  preparation_time_minutes   Int      @default(30)
  latitude                   Float?
  longitude                  Float?
  service_radius_km          Float    @default(10.0)
  is_open                    Boolean  @default(true)
  is_online                  Boolean  @default(true)
  holiday_mode_enabled       Boolean  @default(false)
  holiday_starts_at          DateTime?
  holiday_ends_at            DateTime?
  holiday_reason             String?
  manual_online_override     Boolean?
  notification_preferences   Json?
  average_rating             Float    @default(4.5)
  onboarding_submitted_at    DateTime?
  approved_at                DateTime?
  last_status_change_at      DateTime?
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  account                    Account? @relation(fields: [account_id], references: [id])

  products                      Product[]
  orders                        Order[]
  payouts                       Payout[]
  reviews                       Review[]
  offers                        Offer[]
  documents                     VendorDocument[]
  document_reviews              VendorDocumentReview[]
  operating_hours               VendorOperatingHour[]
  service_areas                 VendorServiceArea[]
  notifications                 VendorNotification[]
  settlements                   VendorSettlement[]
  vendor_transactions           VendorTransaction[]
  commissions                   Commission[]
  inventory_reservations        InventoryReservation[]
  vendor_audit_logs             VendorAuditLog[]
  current_prescription_orders   PrescriptionOrder[] @relation("CurrentVendor")
  assigned_prescription_orders  PrescriptionOrder[] @relation("AssignedVendor")
  prescription_assignments      PrescriptionAssignmentLog[]
  staff                         VendorStaff[]
  product_inventories           ProductInventory[]
  inventory_batches             InventoryBatch[]
  inventory_transactions        InventoryTransaction[]
  order_events                  OrderEvent[]
  login_activities              VendorLoginActivity[]
  prescription_reviews          PrescriptionReview[]

  @@index([status])
  @@index([city])
  @@index([is_online, is_open])
  @@map("vendors")
}

model Product {
  id          String   @id @default(uuid())
  vendor_id   String
  name        String
  slug        String?
  formula     String?
  generic_name String?
  brand_name  String?
  manufacturer String?
  description String?
  usage_instructions String?
  warnings    String?
  side_effects String?
  contraindications String?
  price       Float
  retail_price Float?
  sale_price  Float?
  cost_price  Float?
  stock       Int      @default(0)
  image_url   String?
  category    String?
  subcategory String?
  dosage_form String?
  strength    String?
  pack_size   String?
  sku         String?
  barcode     String?
  prescription_required Boolean @default(false)
  controlled_medicine Boolean @default(false)
  listing_status String @default("ACTIVE")
  low_stock_threshold Int @default(10)
  approval_status String   @default("pending_review")
  review_note     String?
  approved_at     DateTime?
  reviewed_at     DateTime?
  reviewed_by_account_id String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?

  vendor      Vendor   @relation(fields: [vendor_id], references: [id])
  order_items OrderItem[]
  reviews     Review[]
  prescriptions Prescription[]
  prescription_order_items PrescriptionOrderItem[]
  offers      Offer[]
  inventory_reservations InventoryReservation[]
  inventory   ProductInventory?
  batches     InventoryBatch[]
  inventory_transactions InventoryTransaction[]

  @@index([vendor_id, approval_status])
  @@index([vendor_id, listing_status])
  @@index([vendor_id, sku])
  @@index([barcode])
  @@map("products")
}

model Order {
  id                    String   @id @default(uuid())
  customer_id           String
  vendor_id             String
  checkout_session_id   String?
  order_number          String?  @unique
  total_amount          Float
  status                String   @default("pending")
  payment_status        String   @default("unpaid")
  delivery_method       String   @default("delivery")
  subtotal              Float?
  discount_amount       Float    @default(0)
  delivery_fee          Float    @default(0)
  platform_fee          Float    @default(0)
  commission_amount     Float    @default(0)
  vendor_net            Float?
  refund_amount         Float    @default(0)
  requires_prescription Boolean  @default(false)
  delivery_address      Json
  rejection_reason      String?
  cancelled_by          String?
  cancelled_at          DateTime?
  cancellation_reason   String?
  accepted_at           DateTime?
  preparing_at          DateTime?
  ready_at              DateTime?
  out_for_delivery_at   DateTime?
  delivered_at          DateTime?
  completed_at          DateTime?
  rider_name            String?
  tracking_code         String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  customer              User     @relation(fields: [customer_id], references: [id])
  vendor                Vendor   @relation(fields: [vendor_id], references: [id])
  items                 OrderItem[]
  transactions          OrderTransaction[]
  commissions           Commission[]
  prescriptions         Prescription[]
  return_requests       ReturnRequest[]
  vendor_transactions   VendorTransaction[]
  inventory_reservations InventoryReservation[]
  events                OrderEvent[]

  @@index([vendor_id, status])
  @@index([vendor_id, created_at])
  @@index([order_number])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  order_id    String
  product_id  String
  quantity    Int
  unit_price  Float

  order       Order    @relation(fields: [order_id], references: [id])
  product     Product  @relation(fields: [product_id], references: [id])

  @@map("order_items")
}

model Transaction {
  id                String   @id @default(uuid())
  amount            Float
  type              String   // payment, refund
  gateway_reference String?
  status            String   @default("pending") // pending, completed, failed
  created_at        DateTime @default(now())

  order_transactions OrderTransaction[]

  @@map("transactions")
}

model OrderTransaction {
  id             String   @id @default(uuid())
  transaction_id String
  order_id       String

  transaction    Transaction @relation(fields: [transaction_id], references: [id])
  order          Order       @relation(fields: [order_id], references: [id])

  @@map("order_transactions")
}

model Commission {
  id          String   @id @default(uuid())
  order_id    String
  vendor_id   String
  amount      Float
  rate_applied Float   @default(0)
  settlement_id String?
  status      String   @default("pending")
  created_at  DateTime @default(now())

  order       Order    @relation(fields: [order_id], references: [id])
  vendor      Vendor   @relation(fields: [vendor_id], references: [id])
  settlement  VendorSettlement? @relation(fields: [settlement_id], references: [id])

  @@index([vendor_id, status])

  @@map("commissions")
}

model Payout {
  id                String   @id @default(uuid())
  vendor_id         String
  payout_number     String?
  amount            Float
  gross_amount      Float?
  fees              Float    @default(0)
  refunds           Float    @default(0)
  adjustments       Float    @default(0)
  net_amount        Float?
  status            String   @default("pending")
  method            String?
  period_start      DateTime?
  period_end        DateTime?
  payout_date       DateTime?
  gateway_reference String?
  created_at        DateTime @default(now())

  vendor            Vendor   @relation(fields: [vendor_id], references: [id])

  @@index([vendor_id, created_at])
  @@map("payouts")
}

model Prescription {
  id          String   @id @default(uuid())
  customer_id String
  order_id    String?
  product_id  String?
  file_url    String
  status      String   @default("pending") // pending, verified, rejected
  verified_by String?
  notes       String?
  created_at  DateTime @default(now())

  customer    User     @relation(fields: [customer_id], references: [id])
  order       Order?   @relation(fields: [order_id], references: [id])
  product     Product? @relation(fields: [product_id], references: [id])

  @@map("prescriptions")
}

model PrescriptionOrder {
  id                     String    @id @default(uuid())
  customer_id            String
  file_url               String
  delivery_address       Json
  delivery_type          String    @default("standard") // express, standard
  /// Fulfillment lifecycle (separate from payment_status)
  status                 String    @default("finding_vendor")
  payment_status         String    @default("not_required") // not_required|pending|processing|paid|failed|refunded|partially_refunded
  payment_method         String?   // stripe|cod
  estimated_value        Float     @default(0)
  total_amount           Float     @default(0)
  delivery_fee           Float     @default(0)
  quotation_locked_at    DateTime?
  quotation_expires_at   DateTime?
  quotation_version      Int       @default(0)
  paid_at                DateTime?
  cancellation_reason    String?
  current_vendor_id      String?
  assigned_vendor_id     String?
  accept_deadline        DateTime?
  rejected_vendor_ids    Json      @default("[]")
  assignment_attempts    Int       @default(0)
  stock_status           String?
  customer_confirmed     Boolean   @default(false)
  distance_km            Float?
  eta_minutes            Int?
  medicine_count         Int       @default(0)
  stripe_session_id      String?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  customer               User      @relation(fields: [customer_id], references: [id])
  current_vendor         Vendor?   @relation("CurrentVendor", fields: [current_vendor_id], references: [id])
  assigned_vendor        Vendor?   @relation("AssignedVendor", fields: [assigned_vendor_id], references: [id])
  items                  PrescriptionOrderItem[]
  assignment_logs        PrescriptionAssignmentLog[]
  vendor_transactions    VendorTransaction[]
  reviews                PrescriptionReview[]

  @@index([current_vendor_id, status])
  @@index([assigned_vendor_id, status])
  @@index([status, payment_status])
  @@index([quotation_expires_at])
  @@map("prescription_orders")
}

model PrescriptionOrderItem {
  id                    String   @id @default(uuid())
  prescription_order_id String
  name                  String
  quantity              Int      @default(1)
  unit_price            Float    @default(0)
  availability          String   @default("pending")
  product_id            String?
  decision              String?
  matched_quantity      Int?

  prescription_order    PrescriptionOrder @relation(fields: [prescription_order_id], references: [id], onDelete: Cascade)
  product               Product?          @relation(fields: [product_id], references: [id])

  @@map("prescription_order_items")
}

model PrescriptionAssignmentLog {
  id                    String   @id @default(uuid())
  prescription_order_id String
  vendor_id             String
  action                String   // offered, accepted, declined, timeout, offline
  score                 Float?
  created_at            DateTime @default(now())

  prescription_order    PrescriptionOrder @relation(fields: [prescription_order_id], references: [id], onDelete: Cascade)
  vendor                Vendor            @relation(fields: [vendor_id], references: [id])

  @@map("prescription_assignment_logs")
}

model Review {
  id          String   @id @default(uuid())
  customer_id String
  product_id  String?
  vendor_id   String?
  rating      Int
  comment     String?
  created_at  DateTime @default(now())

  customer    User     @relation(fields: [customer_id], references: [id])
  product     Product? @relation(fields: [product_id], references: [id])
  vendor      Vendor?  @relation(fields: [vendor_id], references: [id])

  @@map("reviews")
}

model AuditLog {
  id          String   @id @default(uuid())
  user_id     String?  // nullable if system action
  action      String
  entity      String
  entity_id   String?
  details     Json?
  created_at  DateTime @default(now())

  @@index([entity, created_at])
  @@index([user_id, created_at])
  @@map("audit_logs")
}

model VendorDocument {
  id               String   @id @default(uuid())
  vendor_id        String
  type             String
  file_url         String
  status           String   @default("pending")
  uploaded_by      String?
  verified_at      DateTime?
  rejection_reason String?
  expires_at       DateTime?
  metadata         Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  vendor           Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  reviews          VendorDocumentReview[]

  @@index([vendor_id, status])
  @@index([type])
  @@map("vendor_documents")
}

model VendorDocumentReview {
  id          String   @id @default(uuid())
  document_id String
  vendor_id   String
  reviewer_id String?
  status      String
  notes       String?
  created_at  DateTime @default(now())

  document    VendorDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  vendor      Vendor         @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([document_id])
  @@index([vendor_id])
  @@map("vendor_document_reviews")
}

model VendorOperatingHour {
  id          String   @id @default(uuid())
  vendor_id   String
  day_of_week Int
  open_time   String?
  close_time  String?
  is_closed   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  vendor      Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([vendor_id, day_of_week])
  @@map("vendor_operating_hours")
}

model VendorServiceArea {
  id           String   @id @default(uuid())
  vendor_id    String
  name         String
  city         String?
  postal_codes Json?
  is_active    Boolean  @default(true)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  vendor       Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([vendor_id, is_active])
  @@map("vendor_service_areas")
}

model VendorNotification {
  id         String   @id @default(uuid())
  vendor_id  String
  type       String
  title      String
  message    String
  status     String   @default("unread")
  channel    String   @default("in_app")
  data       Json?
  created_at DateTime @default(now())
  read_at    DateTime?

  vendor     Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([vendor_id, status, created_at])
  @@map("vendor_notifications")
}

model VendorSettlement {
  id                String   @id @default(uuid())
  vendor_id         String
  period_start      DateTime
  period_end        DateTime
  status            String   @default("draft")
  gross_amount      Float    @default(0)
  commission_amount Float    @default(0)
  net_amount        Float    @default(0)
  released_at       DateTime?
  reference         String?
  notes             String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  vendor            Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  transactions      VendorTransaction[]
  commissions       Commission[]

  @@index([vendor_id, status])
  @@map("vendor_settlements")
}

model VendorTransaction {
  id                    String   @id @default(uuid())
  vendor_id             String
  order_id              String?
  prescription_order_id String?
  settlement_id         String?
  type                  String
  status                String   @default("pending")
  gross_amount          Float    @default(0)
  commission_amount     Float    @default(0)
  net_amount            Float    @default(0)
  currency              String   @default("PKR")
  reference             String?
  meta                  Json?
  created_at            DateTime @default(now())

  vendor                Vendor             @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  order                 Order?             @relation(fields: [order_id], references: [id])
  prescription_order    PrescriptionOrder? @relation(fields: [prescription_order_id], references: [id])
  settlement            VendorSettlement?  @relation(fields: [settlement_id], references: [id])

  @@index([vendor_id, status, created_at])
  @@index([order_id])
  @@index([settlement_id])
  @@map("vendor_transactions")
}

model VendorAuditLog {
  id         String   @id @default(uuid())
  vendor_id  String
  user_id    String?
  action     String
  entity     String
  entity_id  String?
  details    Json?
  created_at DateTime @default(now())

  vendor     Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([vendor_id, created_at])
  @@index([action])
  @@map("vendor_audit_logs")
}

model InventoryReservation {
  id          String   @id @default(uuid())
  product_id  String
  vendor_id   String
  customer_id String?
  order_id    String?
  quantity    Int
  status      String   @default("active")
  lock_key    String
  source      String   @default("checkout")
  expires_at  DateTime
  released_at DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  product     Product  @relation(fields: [product_id], references: [id])
  vendor      Vendor   @relation(fields: [vendor_id], references: [id])
  customer    User?    @relation(fields: [customer_id], references: [id])
  order       Order?   @relation(fields: [order_id], references: [id])

  @@index([product_id, status, expires_at])
  @@index([vendor_id, status])
  @@index([customer_id])
  @@index([lock_key])
  @@map("inventory_reservations")
}

model Coupon {
  id                  String   @id @default(uuid())
  code                String   @unique
  discount_type       String   // "percentage" | "fixed"
  discount_value      Float
  min_order_amount    Float    @default(0.0)
  max_discount_amount Float?
  start_date          DateTime
  expiry_date         DateTime
  usage_limit         Int?
  used_count          Int      @default(0)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("coupons")
}

model Offer {
  id                      String   @id @default(uuid())
  title                   String
  short_description       String   @default("")
  description             String   @default("")
  type                    String   @default("PERCENTAGE_DISCOUNT") // PERCENTAGE_DISCOUNT, FIXED_DISCOUNT, FREE_DELIVERY, PROMO_CODE, BANK_OFFER, WALLET_OFFER, PRODUCT_DISCOUNT, CATEGORY_DISCOUNT, PROVIDER_DISCOUNT, FIRST_ORDER, FIRST_BOOKING
  discount_type           String   @default("PERCENTAGE") // PERCENTAGE, FIXED, FREE_DELIVERY
  percentage_value        Float?
  fixed_amount            Float?
  promo_code              String?
  start_at                DateTime @default(now())
  end_at                  DateTime
  status                  String   @default("ACTIVE") // DRAFT, SCHEDULED, ACTIVE, PAUSED, EXPIRED, EXHAUSTED
  minimum_order_amount    Float    @default(0.0)
  maximum_discount_amount Float?
  total_usage_limit       Int?
  used_count              Int      @default(0)
  usage_per_user          Int      @default(1)
  new_users_only          Boolean  @default(false)
  automatic_apply         Boolean  @default(true)
  stackable               Boolean  @default(false)
  funding_source          String   @default("MEDZOOS") // MEDZOOS, PHARMACY, LAB, DOCTOR, BANK, SHARED

  // Granular targeting arrays (stored as JSON)
  city_ids                Json?
  vendor_ids              Json?
  lab_ids                 Json?
  doctor_ids              Json?
  product_ids             Json?
  category_ids            Json?
  lab_test_ids            Json?
  payment_method_ids      Json?

  // Visuals & Terms
  banner_image            String?
  thumbnail_image         String?
  partner_logo            String?
  terms_and_conditions    String?

  // Optional relations
  vendor_id               String?
  product_id              String?
  discount_percentage     Float?
  start_date              DateTime?
  expiry_date             DateTime?
  is_active               Boolean  @default(true)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  vendor                  Vendor?  @relation(fields: [vendor_id], references: [id])
  product                 Product? @relation(fields: [product_id], references: [id])
  redemptions             OfferRedemption[]

  @@index([status, start_at, end_at])
  @@index([promo_code])
  @@index([type])
  @@map("offers")
}

model OfferRedemption {
  id              String   @id @default(uuid())
  offer_id        String
  user_id         String
