  is_read        Boolean   @default(false)
  created_at     DateTime  @default(now())
  read_at        DateTime?

  @@index([recipient_type, recipient_id, is_read, created_at])
  @@index([created_at])
  @@map("inbox_notifications")
}

model ContactInquiry {
  id         String   @id @default(uuid())
  first_name String
  last_name  String   @default("")
  email      String
  phone      String?
  type       String   @default("general")
  subject    String   @default("")
  message    String
  status     String   @default("new")
  user_id    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status, created_at])
  @@index([email])
  @@map("contact_inquiries")
}

model MedicineCategory {
  id         String   @id @default(uuid())
  name       String   @unique
  slug       String   @unique
  parent_id  String?
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)

  parent     MedicineCategory?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children   MedicineCategory[] @relation("CategoryTree")

  @@map("medicine_categories")
}

model ProductInventory {
  id                 String   @id @default(uuid())
  vendor_id          String
  product_id         String   @unique
  available_quantity Int      @default(0)
  reserved_quantity  Int      @default(0)
  sold_quantity      Int      @default(0)
  damaged_quantity   Int      @default(0)
  expired_quantity   Int      @default(0)
  updated_at         DateTime @updatedAt

  vendor             Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([vendor_id])
  @@map("inventory")
}

model InventoryBatch {
  id                 String   @id @default(uuid())
  vendor_id          String
  product_id         String
  batch_number       String
  manufacturing_date DateTime?
  expiry_date        DateTime?
  purchase_price     Float?
  quantity_received  Int      @default(0)
  quantity_available Int      @default(0)
  supplier_name      String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  vendor             Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  transactions       InventoryTransaction[]

  @@index([vendor_id, product_id])
  @@index([product_id, expiry_date])
  @@unique([vendor_id, product_id, batch_number])
  @@map("inventory_batches")
}

model InventoryTransaction {
  id             String   @id @default(uuid())
  vendor_id      String
  product_id     String
  batch_id       String?
  type           String
  quantity       Int
  reference_type String?
  reference_id   String?
  reason         String?
  performed_by   String?
  created_at     DateTime @default(now())

  vendor         Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  batch          InventoryBatch? @relation(fields: [batch_id], references: [id])

  @@index([vendor_id, created_at])
  @@index([product_id, created_at])
  @@map("inventory_transactions")
}

model OrderEvent {
  id         String   @id @default(uuid())
  vendor_id  String
  order_id   String
  status     String
  note       String?
  actor_id   String?
  actor_type String?
  created_at DateTime @default(now())

  vendor     Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id, created_at])
  @@map("order_events")
}

model VendorStaff {
  id           String    @id @default(uuid())
  vendor_id    String
  account_id   String?   @unique
  name         String
  email        String
  role         String    @default("VIEWER")
  status       String    @default("invited")
  invited_at   DateTime  @default(now())
  accepted_at  DateTime?
  last_login_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  vendor       Vendor    @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  account      Account?  @relation(fields: [account_id], references: [id])

  @@unique([vendor_id, email])
  @@index([vendor_id, status])
  @@map("vendor_staff")
}

model VendorLoginActivity {
  id         String   @id @default(uuid())
  vendor_id  String
  account_id String?
  staff_id   String?
  ip_address String?
  user_agent String?
  success    Boolean  @default(true)
  created_at DateTime @default(now())

  vendor     Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([vendor_id, created_at])
  @@map("vendor_login_activities")
}

model PrescriptionReview {
  id               String    @id @default(uuid())
  vendor_id        String
  prescription_id  String
  status           String
  reviewed_by      String?
  reviewed_at      DateTime?
  decision         String?
  notes            String?
  rejection_reason String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  vendor           Vendor            @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  prescription     PrescriptionOrder @relation(fields: [prescription_id], references: [id], onDelete: Cascade)

  @@index([vendor_id, status])
  @@index([prescription_id])
  @@map("prescription_reviews")
}
